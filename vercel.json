{
  "version": 2,
  "builds": [
    {
      "src": "EmployeeManagementSystem/EmployeeManagementSystem.csproj",
      "use": "@vercel/dotnet",
      "config": {
        "command": "dotnet restore && dotnet build EmployeeManagementSystem/EmployeeManagementSystem.csproj -c Release"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api"
    }
  ]
}
